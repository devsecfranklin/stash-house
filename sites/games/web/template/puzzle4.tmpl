{{define "puzzle4Page"}}

<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content= "width=device-width, initial-scale=1.0">
    <meta name="description" content= "games.bitsmasher.net CTF style puzzle">
    <meta name="author" content="thedevilsvoice">
    <meta name="orcid" content="https://orcid.org/0000-0003-4586-8500">
    <meta name="keywords" content="HTML, CSS, GoLang">
    <meta name="robots" content= "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href= "https://games.bitsmasher.net/web/static/css/puzzle.css">
</head>

<body>

    <div class="puzzle">
        <div class="center">
            <h2>Time to log in to the Network</h2> <br />
            <img src="https://games.bitsmasher.net/web/static/images/archie1.jpg" alt="Made with vi on an IBM 8088"><br />
            <em>“Indeed, the safest road to Hell is the gradual one—the gentle slope, soft underfoot, without sudden turnings, without milestones, without signposts.” – C. S. Lewis</em> <br />
        </div>
   </div>

    <h3>Download git repository</h3>


    <div class="puzzle">
        <div class="center">
            <form action="/submission" method="get">
                <table border="1">
                    
                    <tr>
                        <th>Date</th>
                        <th>Puzzle</th>
                        <th>Flag</th>
                    </tr>

                    <tr>
                        <td>May 23, 2025</td>
                        <td>Puzzle2 <input type="hidden" name="puzzle" value="puzzle2-3"></td>                
                        <td>Flag: <input type="text" name="flag" placeholder="probably-wrong"></td>
                    </tr>

                </table>

                <input type="submit" value="Submit">

            </form>
        </div>
    </div>

{{template "footer"}}

</body>
</html>
{{ end }} 


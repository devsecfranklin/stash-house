{{define "submitPage"}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>wrong answer headquarters</title>
    <link rel="stylesheet" type="text/css" href="/static/css/style.css" />
  </head>

  <body>
    <div class="container">
    For {{ .Puzzle }} you submitted {{ .Flag }}.
    </div>
    <div class="submit_box">
    <table border="1">
        <tr>
            <td>
                <form action="https://www.bitsmasher.net:6969/" method="get">
                    Puzzle: <select name="puzzle" id="puzzle">
                        <option value="puzzle1">puzzle 1</option>
                    </select>
            <td>
                Flag: <input type="text" name="flag" placeholder="probably-wrong" />
            </td>
            <td><input type="submit" value="Submit" /></td>
            </form>
            </td>
        </tr>
    </table>
    </div>

  </body>
</html>
{{end}}

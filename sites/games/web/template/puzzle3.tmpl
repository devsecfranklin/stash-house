{{define "puzzle3Page"}}

<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="games.bitsmasher.net CTF style puzzle">
    <meta name="author" content="thedevilsvoice">
    <meta name="keywords" content="HTML, CSS, GoLang">
    <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="https://games.bitsmasher.net/web/static/css/puzzle.css">
</head>

<body>

    <em></em>
    <br />
    <div class="puzzle">
        <center>
        <h2>Puzzle Three</h2>
    Now it's time to check out some of the things on the lab network that you can interact with. 

    <h3>The Gopher server</h3>
        <a href="https://www.howtogeek.com/661871/the-web-before-the-web-a-look-back-at-gopher/"></a>
        </center>
    </div>

    <div class="puzzle">
        <form action="/submission" method="get">
            <table border="1">
                
                <tr>
                    <th>Date</th>
                    <th>Puzzle</th>
                    <th>Flag</th>
                </tr>

                <tr>
                    <td>May 23, 2025</td>
                    <td>Puzzle3 <input type="hidden" name="puzzle" value="puzzle3"></td>               
                    <td>Flag: <input type="text" name="flag" placeholder="probably-wrong"></td>
                </tr>

            </table>

            <input type="submit" value="Submit">

        </form>
    </div>

{{template "footer"}}

</body>
</html>
{{end}}


{{define "puzzle3Page"}}

{{template "header"}}

<body>

<div class="center">
    <h2>Time to log in to the Network</h2> <br />
    <img src="/static/games/images/hot-pizza-torment.png" alt="Made with vi on an IBM 8088"><br />
    <img src="/static/games/images/271895776-2652456453.jpg" alt="On the Internet, nobody knows youre a dog."><br />
</div>

<div class="center">
    <div class="puzzle">
    <img src="/static/games/images/eternal-torment.png" alt="Made with vi on an IBM 8088"><br />
        <h3>Clone the git repository</h3>
        <a href="https://github.com/devsecfranklin/eternal-torment">clone this repository</a><br />

        <form action="/submission" method="get">
            <table border="1">
                <tr>
                    <th>Date</th>
                    <th>Puzzle</th>
                    <th>Flag</th>
                </tr>

                <tr>
                    <td>July 01, 2025</td>
                    <td>Puzzle3 <input type="hidden" name="puzzle" value="puzzle3-1">puzzle 3-1</td>                
                    <td>Flag: <input type="text" name="flag" placeholder="probably-wrong"></td>
                </tr>
            </table>
            <input type="submit" value="Submit">
        </form>
    </div>
</div>

{{template "footer"}}

</body>
</html>

{{end}}


{{define "correctPage"}}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content= "width=device-width, initial-scale=1.0">
    <meta name="description" content= "games.bitsmasher.net CTF style puzzle">
    <meta name="author" content="thedevilsvoice">
    <meta name="orcid" content="https://orcid.org/0000-0003-4586-8500">
    <meta name="keywords" content="HTML, CSS, GoLang">
    <meta name="robots" content= "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href= "/static/games/css/submission-correct.css">
</head>

<body>

  <div class="container">
    <audio controls autoplay>
      <source src="/static/games/success-trumpets.mp3" type="audio/mpeg">
      Your browser does not support the audio element.
    </audio>
  </div>

  <div class="puzzle">
  <center>
    For {{ .Puzzle }} you submitted {{ .Flag }} which is CORRECT!!.
    </center>
  </div>

{{template "footer"}}

  </body>
</html>
{{end}}
